<UserControl
    X:Class="SewerDeformationSoftware.Views.PhotoUserView"
    xmlns:X="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns="https://github.com/avaloniaui" MC:Ignorable="D"
    xmlns:SVGImg="using:Avalonia.Svg.Skia"
    xmlns:VM="using:SewerDeformationSoftware.Logics.ViewModels" D:DesignWidth="975" D:DesignHeight="650"
    xmlns:MC="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:D="http://schemas.microsoft.com/expression/blend/2008" DataContext="{StaticResource PhotoDBC}"
    X:DataType="VM:Photo" xmlns:Material="using:Material.Styles.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50.0"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10.0"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Material:Card X:Name="FileUploader" DragDrop.AllowDrop="True">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="95"/>
                            </Grid.ColumnDefinitions>
                            <SVGImg:Svg Path="/Images/FilesImg.svg" Height="50.0"/>
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Text="Kéo và thả hình ảnh của bạn"
                                    VerticalAlignment="Center"
                                    FontWeight="Bold" FontSize="14"/>
                                <TextBlock Grid.Row="1" VerticalAlignment="Center">
                                    Loại hình ảnh:
                                       <Bold>PNG, JPG, WEBP, JPEG, BMP, TIFF</Bold>
                                </TextBlock>
                            </Grid>
                            <Button Content="Browse" Grid.Column="4" Height="50.0" Command="{Binding Browse}"/>
                        </Grid>
                    </Material:Card>
                    <Grid IsVisible="{Binding PhotoName, Converter={StaticResource None2Hidden}}" Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10.0"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10.0"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10.0"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid
                            Margin="10.0"
                            Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="95"/>
                            </Grid.ColumnDefinitions>
                            <SVGImg:Svg Path="/Images/PhotoImg.svg"/>
                            <TextBlock
                                Text="{Binding PhotoName}"
                                VerticalAlignment="Center"
                                Grid.Column="2" FontWeight="Black"/>
                            <Button
                                Content="Remove"
                                Grid.Column="04" Height="50"
                                Command="{Binding Remove}"/>
                        </Grid>
                        <Grid
                            Margin="10.0"
                            Grid.Row="2">
                            <Button
                                Content="Phân đoạn hình ảnh"
                                Height="50" IsDefault="True"
                                Command="{Binding Accept}"/>
                        </Grid>
                        <Grid
                            Margin="10.0"
                            Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" IsVisible="{Binding PlotImage, Converter={StaticResource None2Hidden}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="5.00"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Hình ảnh đã phân đoạn" FontSize="17.000" FontWeight="SemiBold"/>
                                <Material:Card Grid.Row="2">
                                    <Image Source="{Binding PlotImage, Converter={StaticResource None2Unbind}}"/>
                                </Material:Card>
                            </Grid>
                            <Grid Grid.Column="2" IsVisible="{Binding MaskImage, Converter={StaticResource None2Hidden}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="5.00"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Mặt nạ được trực quan" FontSize="17.000" FontWeight="SemiBold"/>
                                <Material:Card Grid.Row="2">
                                    <Image Source="{Binding MaskImage, Converter={StaticResource None2Unbind}}"/>
                                </Material:Card>
                            </Grid>
                        </Grid>
                        <Grid
                            Margin="10.0"
                            Grid.Row="6" IsVisible="{Binding MaskImage, Converter={StaticResource None2Hidden}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="5.00"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock
                                Text="Kết quả trả về"
                                FontWeight="SemiBold"
                                FontSize="017"/>
                            <Grid Grid.Row="02">
                                <Grid.Styles>
                                    <Style Selector="TextBlock.Label">
                                        <Setter Property="FontSize" Value="15"/>
                                        <Setter Property="FontFamily" Value="Courier New"/>
                                    </Style>
                                    <Style Selector="TextBlock.Value">
                                        <Setter Property="FontSize" Value="20"/>
                                        <Setter Property="FontFamily" Value="Courier New"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </Grid.Styles>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="5.00"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="5.00"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Material:Card Grid.Row="00">
                                        <Grid Margin="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="20.0"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="20.0"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock
                                                Text="AspectRatio"
                                                Classes="Label"/>
                                            <TextBlock
                                                Grid.Row="2" Classes="Value" Text="{Binding AspectRatio}"/>
                                        </Grid>
                                    </Material:Card>
                                    <Material:Card Grid.Row="02">
                                        <Grid Margin="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="20.0"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="20.0"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock
                                                Text="Deformation"
                                                Classes="Label"/>
                                            <TextBlock
                                                Grid.Row="2" Classes="Value" Text="{Binding Deformation}"/>
                                        </Grid>
                                    </Material:Card>
                                    <Material:Card Grid.Row="04">
                                        <Grid Margin="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="20.0"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="20.0"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock
                                                Text="Orientation"
                                                Classes="Label"/>
                                            <TextBlock
                                                Grid.Row="2" Classes="Value" Text="{Binding Orientation}"/>
                                        </Grid>
                                    </Material:Card>
                                </Grid>
                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="5.00"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Material:Card Grid.Row="00">
                                        <Grid Margin="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="20.0"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="20.0"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Shape" Classes="Label"/>
                                            <TextBlock Grid.Row="2" Classes="Value" Text="{Binding Shape}"/>
                                        </Grid>
                                    </Material:Card>
                                    <Material:Card Grid.Row="02">
                                        <Grid Margin="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="20.0"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="20.0"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="State" Classes="Label"/>
                                            <TextBlock Grid.Row="2" Classes="Value" Text="{Binding State}"/>
                                        </Grid>
                                    </Material:Card>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>