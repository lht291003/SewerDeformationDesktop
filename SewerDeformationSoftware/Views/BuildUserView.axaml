<UserControl
    X:Class="SewerDeformationSoftware.Views.BuildUserView"
    xmlns:X="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns="https://github.com/avaloniaui" MC:Ignorable="D"
    xmlns:SVGImg="using:Avalonia.Svg.Skia"
    xmlns:VM="using:SewerDeformationSoftware.Logics.ViewModels" D:DesignWidth="975" D:DesignHeight="650"
    xmlns:MC="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:D="http://schemas.microsoft.com/expression/blend/2008" DataContext="{StaticResource BuildDBC}"
    X:DataType="VM:Build" xmlns:Material="using:Material.Styles.Controls">
    <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="50"/>
        <RowDefinition Height="1*"/>
    </Grid.RowDefinitions>
    <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="50"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10.0"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Material:Card
                Padding="0" X:Name="DropCard" DragDrop.AllowDrop="True">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="95"/>
                    </Grid.ColumnDefinitions>
                    <SVGImg:Svg Path="/Images/FilesImg.svg" Height="50"/>
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock
                            Text="Kéo và thả mô hình của bạn"
                            VerticalAlignment="Center"
                            FontWeight="Bold" FontSize="14"/>
                        <TextBlock Grid.Row="1" VerticalAlignment="Center">
                            Loại mô hình: <Bold> ONNX </Bold>
                        </TextBlock>
                    </Grid>
                    <Button Content="Browse" Grid.Column="4" Height="50.0" Command="{Binding Browse}"/>
                </Grid>
            </Material:Card>
            <Grid IsVisible="{Binding ModelName, Converter={StaticResource None2Hidden}}" Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10.0"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10.0"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid
                    Margin="10.0"
                    Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="95"/>
                    </Grid.ColumnDefinitions>
                    <SVGImg:Svg
                        Path="/Images/ModelImg.svg"/>
                    <TextBlock
                        Text="{Binding ModelName}"
                        VerticalAlignment="Center"
                        Grid.Column="2"
                        FontWeight="ExtraBlack"/>
                    <Button Content="Remove" Grid.Column="4" Height="50.0" Command="{Binding Remove}"/>
                </Grid>
                <Grid
                    Margin="10.0"
                    Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10.0"/>
                        <ColumnDefinition Width="1.0*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Thiết bị suy luận" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Grid
                        Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10.0"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton Content="CPU" GroupName="Device" Grid.Column="0"
                                     IsChecked="{Binding GetDevice, Converter={StaticResource Radios2Text}, ConverterParameter='CPU'}"/>
                        <RadioButton Content="GPU" GroupName="Device" Grid.Column="2"
                                     IsChecked="{Binding GetDevice, Converter={StaticResource Radios2Text}, ConverterParameter='GPU'}"/>
                    </Grid>
                </Grid>
                <Grid
                    Margin="10.0"
                    Grid.Row="4">
                    <Button
                        Content="Cài đặt mô hình YOLO"
                        Command="{Binding Upload}"
                        Height="50" IsDefault="True"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Grid>
</UserControl>