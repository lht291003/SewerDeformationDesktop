<Application
    xmlns="https://github.com/avaloniaui" xmlns:X="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:DBContextFiles="using:SewerDeformationSoftware.Logics.ViewModels"
    xmlns:ConverterFiles="using:SewerDeformationSoftware.Logics.Converters"
    X:Class="SewerDeformationSoftware.App" RequestedThemeVariant="Default">
    
    <Application.Styles>
        <FluentTheme/>
    </Application.Styles>

    <Application.Resources>
        <DBContextFiles:Brain X:Key="BrainDBC"/>
        <DBContextFiles:Build X:Key="BuildDBC"/>
        <DBContextFiles:Photo X:Key="PhotoDBC"/>
        <DBContextFiles:Video X:Key="VideoDBC"/>
        <ConverterFiles:PackBinding X:Key="PackBinding"/>
        <ConverterFiles:None2Hidden X:Key="None2Hidden"/>
        <ConverterFiles:Radios2Text X:Key="Radios2Text"/>
        <ConverterFiles:None2Unbind X:Key="None2Unbind"/>
        <ConverterFiles:Bool2Vision X:Key="Bool2Vision"/>
    </Application.Resources>
</Application>